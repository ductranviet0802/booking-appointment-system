// §3.22
model Booking {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingNo           String         @unique @map("booking_no") @db.Char(8)
  clinicId            String         @map("clinic_id") @db.Uuid
  departmentId        String         @map("department_id") @db.Uuid
  visitTypeId         String         @map("visit_type_id") @db.Uuid
  doctorId            String         @map("doctor_id") @db.Uuid
  doctorRequested     Boolean        @map("doctor_requested")
  patientId           String         @map("patient_id") @db.Uuid
  bookedByAccountId   String?        @map("booked_by_account_id") @db.Uuid
  channel             BookingChannel
  slotDate            DateTime       @map("slot_date") @db.Date
  startTime           DateTime       @map("start_time") @db.Time(0)
  endTime             DateTime       @map("end_time") @db.Time(0)
  status              BookingStatus  @default(RESERVED)
  priceYen            Int?           @map("price_yen")
  // Q-003: field-level encryption (N-PI-04) cannot fit VARCHAR(200); ciphertext, ≤ 200 characters checked on the plain text
  notes               Bytes?
  checkedInAt         DateTime?      @map("checked_in_at") @db.Timestamptz(6)
  noShowCandidateAt   DateTime?      @map("no_show_candidate_at") @db.Timestamptz(6)
  adjustRequiredAt    DateTime?      @map("adjust_required_at") @db.Timestamptz(6)
  adjustNotifiedAt    DateTime?      @map("adjust_notified_at") @db.Timestamptz(6)
  canceledAt          DateTime?      @map("canceled_at") @db.Timestamptz(6)
  canceledByKind      ActorKind?     @map("canceled_by_kind")
  canceledByAccountId String?        @map("canceled_by_account_id") @db.Uuid
  cancelReasonCode    CancelReason?  @map("cancel_reason_code")
  cancelReasonText    String?        @map("cancel_reason_text") @db.VarChar(200)
  changeCount         Int            @default(0) @map("change_count") @db.SmallInt
  version             Int            @default(0)
  anonymizedAt        DateTime?      @map("anonymized_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  department    Department     @relation(fields: [departmentId], references: [id])
  visitType     VisitType      @relation(fields: [visitTypeId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  bookedBy      Account?       @relation("BookedBy", fields: [bookedByAccountId], references: [id])
  canceledBy    Account?       @relation("CanceledBy", fields: [canceledByAccountId], references: [id])
  bookingSlots  BookingSlot[]
  events        BookingEvent[]
  questionnaire Questionnaire?
  notifications Notification[]

  @@index([clinicId, slotDate, status])
  @@index([patientId, slotDate])
  @@index([bookedByAccountId, status])
  @@map("bookings")
}

// §3.23
model BookingSlot {
  bookingId String   @map("booking_id") @db.Uuid
  slotId    String   @map("slot_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slot    Slot    @relation(fields: [slotId], references: [id])

  @@id([bookingId, slotId])
  @@index([slotId])
  @@map("booking_slots")
}

// §3.24
model BookingEvent {
  id             BigInt          @id @default(autoincrement())
  bookingId      String          @map("booking_id") @db.Uuid
  event          String          @db.VarChar(24)
  actorKind      ActorKind       @map("actor_kind")
  actorAccountId String?         @map("actor_account_id") @db.Uuid
  channel        BookingChannel?
  before         Json?
  after          Json?
  at             DateTime        @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   Account? @relation(fields: [actorAccountId], references: [id])

  @@index([bookingId, at])
  @@map("booking_events")
}

// §3.25 — answers: encrypted JSON (N-PI-04)
model Questionnaire {
  bookingId   String   @id @map("booking_id") @db.Uuid
  formVersion String   @map("form_version") @db.VarChar(10)
  language    Language
  answers     Bytes
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(6)
  purgeAfter  DateTime @map("purge_after") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("questionnaires")
}

// §3.26 (A04)
model NotificationTemplate {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String            @map("clinic_id") @db.Uuid
  event     NotificationEvent
  channel   NotifyChannel
  language  Language
  subject   String?           @db.VarChar(100)
  body      String
  updatedBy String            @map("updated_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  updater Account @relation("TemplateUpdater", fields: [updatedBy], references: [id])

  @@unique([clinicId, event, channel, language])
  @@map("notification_templates")
}

// §3.27 — outbox and send log; the partial unique key makes B1 idempotent
model Notification {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event             NotificationEvent
  channel           NotifyChannel
  language          Language
  accountId         String?            @map("account_id") @db.Uuid
  patientId         String?            @map("patient_id") @db.Uuid
  bookingId         String?            @map("booking_id") @db.Uuid
  toAddress         String             @map("to_address") @db.VarChar(254)
  status            NotificationStatus
  attempts          Int                @default(0) @db.SmallInt
  nextAttemptAt     DateTime?          @map("next_attempt_at") @db.Timestamptz(6)
  providerMessageId String?            @map("provider_message_id") @db.VarChar(100)
  lastError         String?            @map("last_error") @db.VarChar(500)
  queuedAt          DateTime           @map("queued_at") @db.Timestamptz(6)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account? @relation(fields: [accountId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@unique([bookingId, channel], map: "notifications_remind_once", where: raw("event = 'NT02_REMIND'"))
  @@index([status, nextAttemptAt])
  @@index([accountId])
  @@index([patientId])
  @@map("notifications")
}

// §3.28 (X5)
model ExportFile {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId      String    @map("clinic_id") @db.Uuid
  kind          String    @db.VarChar(10)
  trigger       String    @db.VarChar(10)
  status        String    @db.VarChar(10)
  periodFrom    DateTime? @map("period_from") @db.Date
  periodTo      DateTime? @map("period_to") @db.Date
  changedSince  DateTime? @map("changed_since") @db.Timestamptz(6)
  patientId     String?   @map("patient_id") @db.Uuid
  fileName      String    @map("file_name") @db.VarChar(100)
  storageKey    String?   @map("storage_key") @db.VarChar(300)
  rowCount      Int?      @map("row_count")
  warningCount  Int?      @map("warning_count")
  sha256        String?   @db.Char(64)
  runId         String?   @map("run_id") @db.Uuid
  createdBy     String?   @map("created_by") @db.Uuid
  downloadCount Int       @default(0) @map("download_count") @db.SmallInt
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic  Clinic    @relation(fields: [clinicId], references: [id])
  patient Patient?  @relation(fields: [patientId], references: [id])
  run     BatchRun? @relation(fields: [runId], references: [id])
  creator Account?  @relation(fields: [createdBy], references: [id])

  @@index([clinicId, kind, createdAt])
  @@map("export_files")
}

// §3.29
model BatchRun {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobCode      String      @map("job_code") @db.VarChar(4)
  trigger      String      @db.VarChar(10)
  clinicId     String?     @map("clinic_id") @db.Uuid
  params       Json?
  startedAt    DateTime    @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime?   @map("ended_at") @db.Timestamptz(6)
  status       BatchStatus
  readCount    Int         @map("read_count")
  writtenCount Int         @map("written_count")
  errorCount   Int         @map("error_count")
  message      String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clinic      Clinic?      @relation(fields: [clinicId], references: [id])
  slots       Slot[]
  holidays    Holiday[]
  exportFiles ExportFile[]

  @@index([jobCode, startedAt])
  @@map("batch_runs")
}

// §3.30 — append-only: UPDATE refused by trigger; DELETE kept for B5 (Q-002)
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @db.Timestamptz(6)
  accountId  String?  @map("account_id") @db.Uuid
  role       Role?
  action     String   @db.VarChar(40)
  targetType String?  @map("target_type") @db.VarChar(30)
  targetId   String?  @map("target_id") @db.Uuid
  clinicId   String?  @map("clinic_id") @db.Uuid
  ip         String?  @db.VarChar(45)
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([at])
  @@index([accountId, at])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// §3.31 — vendor-maintained
model SystemSetting {
  key       String   @id @db.VarChar(50)
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}
