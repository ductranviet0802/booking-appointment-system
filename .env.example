# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_appointment?schema=public"
# Rolling slot feed horizon: UTC today through today + this many days (inclusive), 1-365.
BOOKING_WINDOW_DAYS="30"
# Use direct/non-pooling URL for Prisma Migrate (important for hosted PgBouncer setups)
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/booking_appointment?schema=public"
JWT_SECRET="replace-with-at-least-32-characters"
NODE_ENV="development"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ============================================
# SUPABASE (optional, for Supabase-hosted DB)
# ============================================
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# POSTGRES_URL=""
# POSTGRES_URL_NON_POOLING=""
