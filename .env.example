# Every environment variable the app reads. Copy to .env and set the secrets.

# ---- database (docker-compose.yml builds DATABASE_URL from the POSTGRES_* values) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_appointment?schema=public"
# direct / non-pooling URL for Prisma Migrate (PgBouncer setups)
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/booking_appointment?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-me"
POSTGRES_DB="booking_appointment"

# ---- runtime ----
NODE_ENV="development"
# production: secure cookies, HSTS, upgrade-insecure-requests (serve over HTTPS, or on localhost only)
APP_PORT="9105"
# base of the links in mails (verify, reset, booking pages)
APP_BASE_URL="http://localhost:3000"
# allowed Origin values for state-changing requests, comma separated
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# reverse proxies in front of the app whose X-Forwarded-For is trusted (0 = use the socket address)
TRUSTED_PROXY_HOPS="0"

# ---- secrets (at least 32 characters; never commit real values) ----
JWT_SECRET="replace-with-at-least-32-characters"
# AES-256-GCM key of 問診 answers, booking notes and export files; required in production (dev falls back to JWT_SECRET).
# Losing it loses those fields; there is no rotation yet.
FIELD_ENCRYPTION_KEY="replace-with-a-long-random-string"

# ---- booking and limits ----
# slot horizon in days (1-365)
BOOKING_WINDOW_DAYS="30"
BCRYPT_ROUNDS="12"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_PUBLIC_MAX="120"
RATE_LIMIT_AUTH_MAX="25"
RATE_LIMIT_BOOKING_MAX="50"
RATE_LIMIT_HEALTH_MAX="600"
CACHE_TTL_AUTH_ME_SECONDS="60"
CACHE_TTL_DOCTORS_SECONDS="300"
CACHE_TTL_SEARCH_SECONDS="300"
CACHE_TTL_SLOTS_SECONDS="30"
CACHE_TTL_REFERENCE_SECONDS="3600"

# ---- batches (B1-B6) ----
# on = the in-app scheduler and the retry worker run; off = run jobs with `npm run batch -- Bn`
BATCH_SCHEDULER="off"
# where B-job failure alerts go besides the admins (system setting ops_alert_email wins)
OPS_ALERT_EMAIL=""

# ---- files ----
NOTIFY_OUTBOX_DIR="var/outbox"
EXPORT_DIR="var/export"
PHOTO_DIR="var/photos"

# ---- external interfaces (fakes / fixtures by default) ----
# mail / LINE / SMS: fake writes each message to NOTIFY_OUTBOX_DIR
NOTIFY_TRANSPORT="fake"
# X2 LINE Login: fake | line
LINE_LOGIN="fake"
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
# X1 delivery-status webhook shared secret
X1_WEBHOOK_SECRET=""
# X3 holidays: a file path or URL; empty in production = the holiday_source_url setting (cao.go.jp), else the fixture
X3_SOURCE=""
# X4 postcodes: fixture (fixtures/x4/postcodes.json)
X4_SOURCE="fixture"
